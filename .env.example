# ClaimPilot settings. Copy to .env; nothing here is a secret by default.

# The demo database (a file). ./scripts/reset_demo.py deletes only this file and the uploads folder.
CLAIMPILOT_DB=claimpilot.db
CLAIMPILOT_UPLOADS=data/uploads
CLAIMPILOT_IMPORTS=data/imports

# LLM: "off" makes every agent use its labelled template (fully deterministic demo).
# Leave unset to try a local Ollama model first, then Gemini if a key is set.
CLAIMPILOT_LLM=off
CLAIMPILOT_LLM_TIMEOUT=60
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# GEMINI_API_KEY=            # put a real key only in .env, never in git
GEMINI_MODEL=gemini-2.5-flash

# Simulated insurer habits: "standard" or "held_out".
CLAIMPILOT_SIMULATOR=standard

# Optional officer tokens ("Name=token,Name2=token2"). Unset = demo mode with self-declared names.
# CLAIMPILOT_OFFICER_TOKENS=
